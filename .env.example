# GridShift server-only configuration.
# Copy this file to .env for local/self-hosted deployments. Never commit real values.

# Required in production for signed/encrypted server cookies and sessions.
GRIDSHIFT_SESSION_SECRET=

# BALLDONTLIE live NFL data. Server-only: never prefix this with VITE_.
GRIDSHIFT_BDL_API_KEY=
# Capability profile. Use free, all-star, goat, or trial.
GRIDSHIFT_BDL_TIER=unknown
# Explicit provider-account limit. Keep this at 5 for an unknown tier or GOAT
# trial; use 60 for ALL-STAR or 600 for a paid GOAT account.
GRIDSHIFT_BDL_EFFECTIVE_MAX_REQ_PER_MIN=5
# Optional operating ceiling. Leave blank to reserve 25% automatically
# (450 for a paid GOAT account configured at 600 RPM).
GRIDSHIFT_BDL_INTERNAL_MAX_REQ_PER_MIN=
# Bounded shared provider cache and trusted reverse-proxy hops.
GRIDSHIFT_BDL_CACHE_MAX_ENTRIES=250
GRIDSHIFT_TRUST_PROXY_HOPS=0

# Optional StoryStats NFL narratives. Server-only: never prefix this with VITE_.
# The beta guard defaults to the StoryStats free allowance of 10 requests per UTC day.
GRIDSHIFT_STORY_STATS_API_KEY=
GRIDSHIFT_STORY_STATS_DAILY_LIMIT=10
# Production automatically warms primetime stories; development stays manual.
GRIDSHIFT_STORY_STATS_AUTOMATION_ENABLED=true

# Local/dev only: generate fixture play-by-play for Companion Live when provider
# play access is unavailable. Never use this to represent production data.
GRIDSHIFT_LIVE_MOCK_PLAYS=false

# Local/dev only: let Fantasy Live load preseason games. Production is
# regular/postseason-only and ignores this. Used by the Fantasy Live sandbox.
GRIDSHIFT_LIVE_ALLOW_PRESEASON=false

# Comma-separated Sleeper league IDs allowed to use paid live scoring.
# Add gridshift-live-sandbox locally to enable the Fantasy Live dev sandbox
# (see VITE_LIVE_SANDBOX in .env.local). Never allowlist it in production.
GRIDSHIFT_LIVE_ALLOWED_LEAGUE_IDS=

# Optional second gate for allowlisted league members. When blank, an allowlisted
# league starts its browser session automatically; when set, the viewer enters it.
GRIDSHIFT_LIVE_ACCESS_CODE=

# Optional separate cookie secret for live-scoring access cookies.
# If blank, the server should fall back to GRIDSHIFT_SESSION_SECRET.
GRIDSHIFT_LIVE_COOKIE_SECRET=

# Live data cache and rate-limit defaults.
GRIDSHIFT_LIVE_CACHE_TTL_MS=1000
GRIDSHIFT_LIVE_FINAL_TTL_MS=14400000
GRIDSHIFT_LIVE_ARCHIVE_ENABLED=true
GRIDSHIFT_LIVE_MAX_REQ_PER_MIN=300

# Set false only for local HTTP testing. Production cookies should be secure.
GRIDSHIFT_COOKIE_SECURE=true

# Optional device-to-device Draft Sync. Disabled unless explicitly enabled.
# The data directory contains only hashed device/pairing credentials and JSON
# draft-state blobs; keep it on persistent server storage in production.
GRIDSHIFT_DRAFT_SYNC_ENABLED=false
GRIDSHIFT_DRAFT_SYNC_DATA_DIR=/data
GRIDSHIFT_DRAFT_SYNC_PAIRING_TTL_MS=600000
GRIDSHIFT_DRAFT_SYNC_MAX_PAYLOAD_BYTES=65536

# Server-backed Trade Proposal Rooms. Direct-host development uses a writable
# OS temporary directory when this value is omitted. Docker Compose supplies
# the persistent /data volume; direct-host deployments should set this to a
# durable writable directory.
GRIDSHIFT_TRADE_PROPOSALS_ENABLED=true
# GRIDSHIFT_TRADE_PROPOSALS_DATA_DIR=/data
GRIDSHIFT_TRADE_PROPOSALS_TOMBSTONE_RETENTION_MS=2592000000
GRIDSHIFT_TRADE_PROPOSALS_SESSION_RETENTION_MS=7776000000
GRIDSHIFT_TRADE_PROPOSALS_MAX_PAYLOAD_BYTES=65536
