FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY server ./server
COPY src/utils ./src/utils
# Shared utils import static data (for example nflPlays -> data/teamColors.js).
COPY src/data ./src/data

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "server/index.js"]
